.badge {
  display: inline-flex;
  align-items: center;
  padding: 0 var(--sp-1);
  border-radius: var(--r-sm);
  font-size: var(--fs-xs);
  line-height: var(--lh-xs);
  font-weight: var(--fw-medium);
  white-space: nowrap;
}

.badge--danger {
  background: var(--danger-bg);
  color: var(--danger);
}

.badge--warning {
  background: var(--warning-bg);
  color: var(--warning);
}

.badge--success {
  background: var(--success-bg);
  color: var(--success);
}

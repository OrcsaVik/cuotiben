.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-5) var(--page-gutter);
}

.empty-icon {
  margin-bottom: var(--sp-2);
}

.empty-text {
  font-size: var(--fs-sm);
  line-height: var(--lh-sm);
  color: var(--text-2);
  text-align: center;
}

.empty-action {
  margin-top: var(--sp-3);
}

<wxs module="pick">
  module.exports = {
    name: function (list, id) {
      if (!list || !id) return '';
      for (var i = 0; i < list.length; i++) {
        if (list[i].id === id) return list[i].name;
      }
      return '';
    },
    index: function (list, id) {
      if (!list) return 0;
      for (var i = 0; i < list.length; i++) {
        if (list[i].id === id) return i;
      }
      return 0;
    }
  };
</wxs>

<view class="picker-row">
  <picker
    class="picker-col"
    range="{{subjects}}"
    range-key="name"
    value="{{pick.index(subjects, subjectId)}}"
    bindchange="onSubjectChange"
  >
    <view class="picker-box">
      <text class="picker-value {{subjectId ? '' : 'picker-value--empty'}}">
        {{subjectId ? pick.name(subjects, subjectId) : '选择科目'}}
      </text>
      <view class="picker-arrow">
        <mp-icon icon="arrow" size="{{8}}" color="var(--text-3)" />
      </view>
    </view>
  </picker>

  <picker
    class="picker-col"
    range="{{points}}"
    range-key="name"
    value="{{pick.index(points, pointId)}}"
    disabled="{{!subjectId}}"
    bindchange="onPointChange"
  >
    <view class="picker-box {{subjectId ? '' : 'picker-box--off'}}">
      <text class="picker-value {{pointId ? '' : 'picker-value--empty'}}">
        {{pointId ? pick.name(points, pointId) : '选择知识点'}}
      </text>
      <view class="picker-arrow">
        <mp-icon icon="arrow" size="{{8}}" color="var(--text-3)" />
      </view>
    </view>
  </picker>
</view>

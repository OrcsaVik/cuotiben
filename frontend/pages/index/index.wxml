<view class="page-root page-root--tab {{themeClass}}">
  <view wx:if="{{pendingCount > 0}}" class="card reminder" bindtap="onPendingTap">
    <view class="reminder__top">
      <text class="section-title">复习提醒</text>
      <text class="reminder__go">去复习</text>
    </view>
    <view class="reminder__body">
      <text class="stat-num">{{pendingCount}}</text>
      <text class="reminder__text">道错题超过 7 天未复习</text>
    </view>
  </view>

  <block wx:if="{{total > 0}}">
    <view class="card">
      <view class="section-title">概览</view>
      <view class="stats">
        <view class="stat">
          <view class="stat-num">{{total}}</view>
          <view class="stat__label">错题总数</view>
        </view>
        <view class="stat">
          <view class="stat-num">{{weekAdded}}</view>
          <view class="stat__label">本周新增</view>
        </view>
        <view class="stat">
          <view class="stat-num">{{sessionCount}}</view>
          <view class="stat__label">练习次数</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">掌握程度</view>
      <view class="mbar" wx:for="{{masteryRows}}" wx:key="level">
        <text class="mbar__label">{{item.level}}</text>
        <view class="mbar__track">
          <view class="mbar__fill mbar__fill--{{item.tone}}" style="width: {{item.pct}}%"></view>
        </view>
        <text class="mbar__num">{{item.count}}</text>
        <text class="mbar__pct">{{item.pct}}%</text>
      </view>
    </view>

    <view class="card">
      <view class="section-title">科目分布 · 错题数前 5</view>
      <view class="srow" wx:for="{{subjectRows}}" wx:key="subjectId">
        <text class="srow__name">{{item.subjectName}}</text>
        <view class="srow__track">
          <view class="srow__fill" style="width: {{item.width}}%"></view>
        </view>
        <text class="srow__num">{{item.count}}</text>
      </view>
    </view>
  </block>

  <empty-state
    wx:else
    icon="note"
    text="还没有错题"
    action="去录入第一道错题"
    bind:action="onGoCapture"
  />

  <view class="card">
    <view class="section-title">快捷入口</view>
    <view class="grid">
      <view
        class="grid__item"
        hover-class="grid__item--tap"
        wx:for="{{subjects}}"
        wx:key="id"
        data-subject-id="{{item.id}}"
        bindtap="onSubjectTap"
      >{{item.name}}</view>
    </view>
  </view>

  <view wx:if="{{showLoginPrompt}}" class="prompt {{promptReady ? 'is-ready' : ''}}">
    <view class="prompt__mask" bindtap="onPromptCancel" />
    <view class="card prompt__panel">
      <view class="section-title">还没有登录</view>
      <view class="prompt__text">登录后「我的」页会显示你的头像和昵称。错题本来就存在本机，登不登录都不影响。</view>
      <view class="prompt__actions">
        <view class="btn btn-ghost prompt__btn" hover-class="btn-hover" bindtap="onPromptCancel">暂不</view>
        <view class="btn btn-primary prompt__btn" hover-class="btn-hover" bindtap="onPromptLogin">去登录</view>
      </view>
    </view>
  </view>
</view>

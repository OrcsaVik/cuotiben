<view class="page-root {{themeClass}}">
  <view class="ring-wrap">
    <view
      class="ring"
      style="background: conic-gradient(var(--brand) {{pct}}%, var(--bg-subtle) {{pct}}% 100%)"
    >
      <view class="ring__hole">
        <text class="stat-num">{{pct}}%</text>
      </view>
    </view>
    <text class="section-title">正确率</text>
  </view>

  <view class="card">
    <view class="field-row">
      <text class="field-row__label">做对了</text>
      <text class="field-row__value num--success">{{counts.correct}}</text>
    </view>
    <view class="field-row">
      <text class="field-row__label">做错了</text>
      <text class="field-row__value num--danger">{{counts.wrong}}</text>
    </view>
    <view class="field-row">
      <text class="field-row__label">蒙对了</text>
      <text class="field-row__value num--warning">{{counts.lucky}}</text>
    </view>
    <view class="field-row field-row--flat">
      <text class="field-row__label">本次用时</text>
      <text class="field-row__value">{{durationText}}</text>
    </view>
  </view>

  <block wx:if="{{changes.length > 0}}">
    <view class="section-title changes__title">掌握程度变化</view>
    <view class="card change" wx:for="{{changes}}" wx:key="mistakeId">
      <text class="change__stem">{{item.stem}}</text>
      <view class="change__row">
        <mastery-badge mastery="{{item.before}}" />
        <text class="change__arrow">→</text>
        <mastery-badge mastery="{{item.after}}" />
      </view>
    </view>
  </block>

  <view class="actions">
    <button
      wx:if="{{counts.wrong > 0}}"
      class="btn btn-primary"
      bindtap="onRedoWrong"
    >只重做错题</button>
    <button class="btn btn-ghost" bindtap="onGoHome">返回首页</button>
  </view>
</view>

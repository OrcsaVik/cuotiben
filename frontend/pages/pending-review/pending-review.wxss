.pending {
  padding-bottom: calc(var(--tap-min) + var(--sp-6) + env(safe-area-inset-bottom));
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--tap-min);
}

.bar__count {
  font-size: var(--fs-sm);
  line-height: var(--lh-sm);
  color: var(--text-2);
}

.link {
  font-size: var(--fs-sm);
  line-height: var(--lh-sm);
  color: var(--brand);
}

.num {
  color: var(--brand);
  font-variant-numeric: var(--nums);
}

.row {
  padding-top: var(--sp-2);
}

.row__overdue {
  display: block;
  margin-bottom: var(--sp-1);
  font-size: var(--fs-xs);
  line-height: var(--lh-xs);
  font-variant-numeric: var(--nums);
  color: var(--danger);
}

.selbar {
  position: fixed;
  right: var(--page-gutter);
  bottom: calc(var(--sp-2) + env(safe-area-inset-bottom));
  left: var(--page-gutter);
  z-index: var(--z-fab);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  background: var(--bg-card);
  border: var(--border-w) solid var(--border);
  border-radius: var(--r-lg);
  transition: var(--theme-transition);
}

.selbar__count {
  font-size: var(--fs-sm);
  line-height: var(--lh-sm);
  color: var(--text-1);
}

.selbar__btn {
  flex-shrink: 0;
  padding: 0 var(--sp-4);
  font-size: var(--fs-md);
  line-height: var(--lh-md);
}

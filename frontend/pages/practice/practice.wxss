.progress {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: var(--sp-2);
  margin-bottom: var(--sp-4);
}

.progress__num {
  font-size: var(--fs-lg);
  line-height: var(--lh-lg);
}

.question__head {
  display: flex;
  justify-content: flex-end;
  margin-bottom: var(--sp-2);
}

.question__stem {
  display: block;
  font-size: var(--fs-md);
  line-height: var(--lh-md);
  color: var(--text-1);
  white-space: pre-wrap;
  word-break: break-all;
}

.opts {
  display: block;
  margin-top: var(--sp-3);
}

.opt {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-2);
  box-sizing: border-box;
  padding: var(--sp-2);
  margin-bottom: var(--sp-2);
  border: var(--border-w) solid var(--border);
  border-radius: var(--r-md);
  transition: var(--theme-transition);
}

.opt--correct {
  border-color: var(--success);
}

.opt--wrong {
  border-color: var(--danger);
}

.opt__text {
  font-size: var(--fs-md);
  line-height: var(--lh-md);
  color: var(--text-1);
  word-break: break-all;
}

.blanks {
  margin-top: var(--sp-3);
}

.blank {
  margin-bottom: var(--sp-2);
}

.blank__label {
  display: block;
  font-size: var(--fs-xs);
  line-height: var(--lh-xs);
  color: var(--text-3);
  margin-bottom: var(--sp-1);
}

.blank__input {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--tap-min);
  padding: 0 var(--sp-2);
  border: var(--border-w) solid var(--border);
  border-radius: var(--r-md);
  font-size: var(--fs-md);
  line-height: var(--lh-md);
  color: var(--text-1);
  background: var(--bg-card);
}

.selfgrade {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.selfgrade__btn {
  flex: 1;
  padding: 0 var(--sp-2);
  font-size: var(--fs-sm);
}

.verdict {
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
}

.verdict__text {
  font-size: var(--fs-lg);
  line-height: var(--lh-lg);
  font-weight: var(--fw-bold);
}

.verdict--ok .verdict__text {
  color: var(--success);
}

.verdict--bad .verdict__text {
  color: var(--danger);
}

.answer-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-3);
  margin-top: var(--sp-2);
  padding-top: var(--sp-2);
}

.answer-line__value {
  font-size: var(--fs-sm);
  line-height: var(--lh-sm);
  color: var(--text-1);
  text-align: right;
  word-break: break-all;
}

.actions {
  margin-top: var(--sp-4);
}
